                <script>
            function previewFile_input__brochure() {
                const inputFile_input__brochure = document.getElementById('input__brochure');
                const preview_input__brochure = document.getElementById('preview-input__brochure');
                const iframe_input__brochure = document.getElementById('iframe-input__brochure');

                inputFile_input__brochure.addEventListener('change', function() {
                    const file = this.files[0];
                    if (file) {
                        if (file.size > 2048 * 1024) {
                            alert('Ukuran file terlalu besar. Maksimal ' + 2048 + 'KB');
                            inputFile_input__brochure.value = null;
                            inputFile_input__brochure.dispatchEvent(new Event('change', {
                                bubbles: true
                            }));
                            return;
                        }
                        const acceptedTypes = inputFile_input__brochure.accept.split(',').map(type => type
                            .replace('.', ''));
                        const fileExtension = file.name.split('.').pop().toLowerCase();
                        if (!acceptedTypes.includes(fileExtension)) {
                            alert('File harus bertipe ' + inputFile_input__brochure.accept);
                            preview_input__brochure.src = '';
                            inputFile_input__brochure.value = null;
                            inputFile_input__brochure.dispatchEvent(new Event('change', {
                                bubbles: true
                            }));
                            return;
                        }
                        if (file.type.match('image.*')) {
                            preview_input__brochure.classList.remove('hidden');
                            iframe_input__brochure.classList.add('hidden');
                            const reader = new FileReader();
                            reader.onload = function(e) {
                                preview_input__brochure.setAttribute('src', e.target.result);
                            };
                            reader.readAsDataURL(file);
                        } else if (file.type.match('application/pdf')) {
                            preview_input__brochure.classList.add('hidden');
                            iframe_input__brochure.classList.remove('hidden');
                            iframe_input__brochure.src = URL.createObjectURL(file);
                        }
                    } else {
                                                    preview_input__brochure.classList.add('hidden');
                                                iframe_input__brochure.classList.add('hidden');
                    }
                })
            }

            document.addEventListener('livewire:initialized', () => {
                previewFile_input__brochure();
            })

