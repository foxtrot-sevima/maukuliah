            const selectPositions = document.getElementById('select__positions');
            const selectPositionsHidden = document.getElementById('select__positions-hidden');

            function updatePositions() {
                selectPositionsHidden.innerHTML = '';
                if (selectPositions.value) {
                    const options = selectPositions.value.split(',');
                    options.forEach((option) => {
                        const optionElement = document.createElement('option');
                        optionElement.value = option;
                        optionElement.innerText = option;
                        optionElement.setAttribute('selected', '');
                        selectPositionsHidden.appendChild(optionElement);
                    });
                }
            }

            updatePositions();

            selectPositions.addEventListener('change', function() {
                const value = this.value;
                if (!value) {
                    selectPositionsHidden.innerHTML = '';
                    return;
                }
                updatePositions();
            });
