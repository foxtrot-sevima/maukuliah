{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "test \"$VERCEL_GIT_COMMIT_REF\" != \"master\"",
  "github": {
    "silent": true
  },
  "git": {
    "deploymentEnabled": {
      "feat/*": false,
      "fix/*": false,
      "style/*": false,
      "chore/*": false,
      "docs/*": false,
      "refactor/*": false,
      "mockup/*": false
    }
  }
}
