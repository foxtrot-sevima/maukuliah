        <script>
            const selectProvince = document.getElementById('select__province-id');
            const selectCity = document.getElementById('select__city-id');
            const optionCity = document.createElement('option');
            optionCity.value = '';
            optionCity.innerText = '-- Pilih Kota/Kabupaten --';

            selectProvince.addEventListener('change', function() {
                const id = this.value;
                if (!id) {
                    selectCity.disabled = true;
                    return;
                }
                const url = `https://maukuliah.id/super-admin/master/universities/get-city/:id`.replace(':id', id);
                selectCity.disabled = true;
                fetch(url)
                    .then((response) => response.json())
                    .then((data) => {
                        selectCity.innerHTML = '';
                        selectCity.appendChild(optionCity);
                        data.forEach((item) => {
                            const option = document.createElement('option');
                            option.value = item.value;
                            option.innerText = item.label;
                            selectCity.appendChild(option);
                        });
                    });
                selectCity.disabled = false;
            });
            if (selectProvince.value && selectCity.value == null) {
                selectProvince.dispatchEvent(new Event('change'));
                selectCity.disabled = false;
            } else if (selectProvince.value && selectCity.value) {
                selectCity.disabled = false;
            } else {
                selectCity.disabled = true;
            }
        </script>
