        <script>
            function cleanNumber(numberOnly) {
                // If the input is exactly "0", allow it
                if (numberOnly === "0") {
                    return numberOnly;
                }

                // If the input starts with "0" and is not "0", remove the leading zeros
                if (/^0/.test(numberOnly)) {
                    numberOnly = numberOnly.replace(/^0+/, '');
                }

                // Remove any non-digit characters
                numberOnly = numberOnly.replace(/[^0-9]/g, '');

                // Return the cleaned number, defaulting to "0" if it's empty after cleanup
                return numberOnly;
            }

            function formatIntegerOnly(event) {
                let numberOnly = event.target.value;
                numberOnly = cleanNumber(numberOnly);
                event.target.value = numberOnly;

                const inputLabel = event.target.getAttribute('data-label');
                const inputMinLength = event.target.getAttribute('minlength') ?? 0;
                const inputMaxLength = event.target.getAttribute('maxlength') ?? 15;

                if (numberOnly.length > 0 && numberOnly.length < inputMinLength) {
                    event.target.setCustomValidity(inputLabel + ' harus diisi minimal ' + inputMinLength + ' karakter');
                } else if (numberOnly.length > 0 && numberOnly.length > inputMaxLength) {
                    event.target.setCustomValidity(inputLabel + ' harus diisi maksimal ' + inputMaxLength + ' karakter');
                } else {
                    event.target.setCustomValidity('');
                }

                const inputMaxValue = event.target.getAttribute('max');
                if (inputMaxValue && Number.parseInt(numberOnly) > Number.parseInt(inputMaxValue)) {
                    event.target.setCustomValidity(inputLabel + ' tidak boleh lebih dari ' + inputMaxValue);
                }
            }
        </script>
