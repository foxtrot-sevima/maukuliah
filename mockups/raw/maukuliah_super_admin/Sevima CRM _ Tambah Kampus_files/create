                <script>
            function previewFile_input__logo() {
                const inputFile_input__logo = document.getElementById('input__logo');
                const preview_input__logo = document.getElementById('preview-input__logo');
                const iframe_input__logo = document.getElementById('iframe-input__logo');

                inputFile_input__logo.addEventListener('change', function() {
                    const file = this.files[0];
                    if (file) {
                        if (file.size > 2048 * 1024) {
                            alert('Ukuran file terlalu besar. Maksimal ' + 2048 + 'KB');
                            inputFile_input__logo.value = null;
                            inputFile_input__logo.dispatchEvent(new Event('change', {
                                bubbles: true
                            }));
                            return;
                        }
                        const acceptedTypes = inputFile_input__logo.accept.split(',').map(type => type
                            .replace('.', ''));
                        const fileExtension = file.name.split('.').pop().toLowerCase();
                        if (!acceptedTypes.includes(fileExtension)) {
                            alert('File harus bertipe ' + inputFile_input__logo.accept);
                            preview_input__logo.src = '';
                            inputFile_input__logo.value = null;
                            inputFile_input__logo.dispatchEvent(new Event('change', {
                                bubbles: true
                            }));
                            return;
                        }
                        if (file.type.match('image.*')) {
                            preview_input__logo.classList.remove('hidden');
                            iframe_input__logo.classList.add('hidden');
                            const reader = new FileReader();
                            reader.onload = function(e) {
                                preview_input__logo.setAttribute('src', e.target.result);
                            };
                            reader.readAsDataURL(file);
                        } else if (file.type.match('application/pdf')) {
                            preview_input__logo.classList.add('hidden');
                            iframe_input__logo.classList.remove('hidden');
                            iframe_input__logo.src = URL.createObjectURL(file);
                        }
                    } else {
                                                    preview_input__logo.classList.add('hidden');
                                                iframe_input__logo.classList.add('hidden');
                    }
                })
            }

            document.addEventListener('livewire:initialized', () => {
                previewFile_input__logo();
            })

            Livewire.hook('commit', ({
                component,
                commit,
                respond,
                succeed,
                fail
            }) => {
                // Runs immediately before a commit's payload is sent to the server...

                respond(() => {
                    // Runs after a response is received but before it's processed...
                })

                succeed(({
                    snapshot,
                    effect
                }) => {
                    previewFile_input__logo();
                })

                fail(() => {
                    // Runs if some part of the request failed...
                })
            })
        </script>
        <script>
        function formatNumberOnly(event) {
            let numberOnly = event.target.value;
            numberOnly = numberOnly.replace(/[^0-9]/g, '');
            event.target.value = numberOnly;

            const inputLabel = event.target.getAttribute('data-label');
            const inputMinLength = event.target.getAttribute('minlength') ?? 0;
            const inputMaxLength = event.target.getAttribute('maxlength') ?? 15;

            if (numberOnly.length > 0 && numberOnly.length < inputMinLength) {
                event.target.setCustomValidity(inputLabel + ' harus diisi minimal ' + inputMinLength + ' karakter');
            } else if (numberOnly.length > 0 && numberOnly.length > inputMaxLength) {
                event.target.setCustomValidity(inputLabel + ' harus diisi maksimal ' + inputMaxLength + ' karakter');
            } else {
                event.target.setCustomValidity('');
            }
        }
    </script>
