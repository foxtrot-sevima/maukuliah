    <script>
        function sortBy(field) {
            event.preventDefault();
            //get current url
            let url = new URL(window.location.href);

            let sortBy = field;
            let sortDirection = '-';

            //check is url has sortBy and sortDirection params
            if (url.searchParams.has('sort')) {
                //get sortBy and sortDirection params
                sortBy = url.searchParams.get('sort');
                sortDirection = sortBy.substring(0, 1);
                sortBy = sortBy.substring(1);
                //check if sortBy and sortDirection params is equal to field
                if (sortBy === field) {
                    //check if sortDirection is equal to asc
                    if (sortDirection === '-') {
                        //set sortDirection to desc
                        sortDirection = '';
                    } else {
                        //set sortDirection to asc
                        sortDirection = '-';
                    }
                } else {
                    sortBy = field;
                    sortDirection = '-';
                }
            }

            //set sortBy and sortDirection params to url
            url.searchParams.set('sort', sortDirection + sortBy);

            window.location.href = url;
        }
    </script>
