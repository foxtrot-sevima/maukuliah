        <script>
            function previewFile_input__file() {
                const inputFile_input__file = document.getElementById('input__file');
                const preview_input__file = document.getElementById('preview-input__file');
                const iframe_input__file = document.getElementById('iframe-input__file');

                inputFile_input__file.addEventListener('change', function() {
                    const file = this.files[0];
                    if (file) {
                        if (file.size > 2048 * 1024) {
                            alert('Ukuran file terlalu besar. Maksimal ' + 2048 + 'KB');
                            inputFile_input__file.value = null;
                            inputFile_input__file.dispatchEvent(new Event('change', {
                                bubbles: true
                            }));
                            return;
                        }
                        const acceptedTypes = inputFile_input__file.accept.split(',').map(type => type
                            .replace('.', ''));
                        const fileExtension = file.name.split('.').pop().toLowerCase();
                        if (!acceptedTypes.includes(fileExtension)) {
                            alert('File harus bertipe ' + inputFile_input__file.accept);
                            preview_input__file.src = '';
                            inputFile_input__file.value = null;
                            inputFile_input__file.dispatchEvent(new Event('change', {
                                bubbles: true
                            }));
                            return;
                        }
                        if (file.type.match('image.*')) {
                            preview_input__file.classList.remove('hidden');
                            iframe_input__file.classList.add('hidden');
                            const reader = new FileReader();
                            reader.onload = function(e) {
                                preview_input__file.setAttribute('src', e.target.result);
                            };
                            reader.readAsDataURL(file);
                        } else if (file.type.match('application/pdf')) {
                            preview_input__file.classList.add('hidden');
                            iframe_input__file.classList.remove('hidden');
                            iframe_input__file.src = URL.createObjectURL(file);
                        }
                    } else {
                                                    preview_input__file.classList.add('hidden');
                                                iframe_input__file.classList.add('hidden');
                    }
                })
            }

            document.addEventListener('livewire:initialized', () => {
                previewFile_input__file();
            })

            Livewire.hook('commit', ({
                component,
                commit,
                respond,
                succeed,
                fail
            }) => {
                // Runs immediately before a commit's payload is sent to the server...

                respond(() => {
                    // Runs after a response is received but before it's processed...
                })

                succeed(({
                    snapshot,
                    effect
                }) => {
                    previewFile_input__file();
                })

                fail(() => {
                    // Runs if some part of the request failed...
                })
            })
        </script>
